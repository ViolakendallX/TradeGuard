# TradeGuard environment configuration
# Copy this file to ".env" and fill in real values. ".env" is gitignored — never commit it.
# ".env.example" IS committed so the required variables are documented.

# ---------------------------------------------------------------------------
# Market data provider (Phase 3)
# ---------------------------------------------------------------------------
# Default: Bitget public Spot API v2. Requires NO key and NO configuration.
# Recognized rToken assets (e.g. rNVDA) are resolved to their Bitget USDT pair.
TRADEGUARD_MARKET_PROVIDER=bitget

# ---------------------------------------------------------------------------
# Events / catalysts provider (Phase 3)
# ---------------------------------------------------------------------------
# OPTIONAL. If either of the two values below is empty, TradeGuard reports
# events/catalysts as "Data unavailable" with an honest explanation.
#
# Default contract = Financial Modeling Prep earnings calendar:
#   GET {TRADEGUARD_EVENTS_API_BASE}/earnings_calendar?symbol=<EQUITY>&apikey=<KEY>
# Example:
#   TRADEGUARD_EVENTS_API_BASE=https://financialmodelingprep.com/api/v3
#   TRADEGUARD_EVENTS_API_KEY=your_real_key_here
TRADEGUARD_EVENTS_PROVIDER=fmp
TRADEGUARD_EVENTS_API_BASE=
TRADEGUARD_EVENTS_API_KEY=

# ---------------------------------------------------------------------------
# Bitget DEMO (paper) trading — Phase 10
# ---------------------------------------------------------------------------
# OPTIONAL. Paper execution works WITHOUT these: if any of the three credential
# values below is missing, the Paper Execution stage reports
# "PAPER EXECUTION UNAVAILABLE" and names exactly which variables are unset.
# It never fakes a submitted order.
#
# These are DEMO credentials only. TradeGuard reads no live-trading credential
# and has no live-execution path — a live-order fallback does not exist and will
# not be built in this phase.
#
# To obtain them: log in to Bitget, switch to the Demo Trading / paper trading
# area, and create an API key there. A demo key cannot move real funds.
#
# NOTE: Bitget demo API keys may be restricted to specific IP addresses. If you
# create one with an IP restriction, requests from other addresses are rejected
# and TradeGuard will report the provider's own error.
TRADEGUARD_BITGET_DEMO_API_KEY=
TRADEGUARD_BITGET_DEMO_API_SECRET=
TRADEGUARD_BITGET_DEMO_PASSPHRASE=

# OPTIONAL. Override only if Bitget publishes a different demo host.
# Leave empty to use the default. This must remain the DEMO host.
TRADEGUARD_BITGET_DEMO_API_BASE=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787
