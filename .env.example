# TradeGuard environment configuration
# Copy this file to ".env" and fill in real values. ".env" is gitignored — never commit it.
# ".env.example" IS committed so the required variables are documented.

# ---------------------------------------------------------------------------
# Market data provider (Phase 3)
# ---------------------------------------------------------------------------
# Default: Bitget public Spot API v2. Requires NO key and NO configuration.
# Recognized rToken assets (e.g. rNVDA) are resolved to their Bitget USDT pair.
TRADEGUARD_MARKET_PROVIDER=bitget

# ---------------------------------------------------------------------------
# Events / catalysts provider (Phase 3)
# ---------------------------------------------------------------------------
# OPTIONAL. If either of the two values below is empty, TradeGuard reports
# events/catalysts as "Data unavailable" with an honest explanation.
#
# Default contract = Financial Modeling Prep earnings calendar:
#   GET {TRADEGUARD_EVENTS_API_BASE}/earnings_calendar?symbol=<EQUITY>&apikey=<KEY>
# Example:
#   TRADEGUARD_EVENTS_API_BASE=https://financialmodelingprep.com/api/v3
#   TRADEGUARD_EVENTS_API_KEY=your_real_key_here
TRADEGUARD_EVENTS_PROVIDER=fmp
TRADEGUARD_EVENTS_API_BASE=
TRADEGUARD_EVENTS_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787
